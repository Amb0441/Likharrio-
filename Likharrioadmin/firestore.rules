rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function changedOnly(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    function userProtectedUntouched() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['role', 'suspended', 'pendingDelete', 'disabled', 'verified']);
    }

    function artistStatusAllowed() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['artistStatus'])
        || request.resource.data.artistStatus in ['pending', 'unsubmitted'];
    }

    function privateProfileKeys() {
      return ['email', 'age', 'gender', 'phone', 'phoneNumber', 'address', 'usedReferralCode'];
    }

    function noPrivateProfileFields() {
      return !request.resource.data.keys().hasAny(privateProfileKeys());
    }

    function privateProfileUnchangedOrRemoved() {
      return (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['email'])
          || !request.resource.data.keys().hasAny(['email']))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['age'])
          || !request.resource.data.keys().hasAny(['age']))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['gender'])
          || !request.resource.data.keys().hasAny(['gender']))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['phone'])
          || !request.resource.data.keys().hasAny(['phone']))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['phoneNumber'])
          || !request.resource.data.keys().hasAny(['phoneNumber']))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['address'])
          || !request.resource.data.keys().hasAny(['address']))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['usedReferralCode'])
          || !request.resource.data.keys().hasAny(['usedReferralCode']));
    }

    function stepped(field) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([field])
        || (
          request.resource.data.get(field, 0) is number
          && resource.data.get(field, 0) is number
          && (
            request.resource.data.get(field, 0) == resource.data.get(field, 0) + 1
            || request.resource.data.get(field, 0) == resource.data.get(field, 0) - 1
          )
        );
    }

    function engagementStep() {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['likes', 'saves', 'views', 'shares', 'likesCount'])
        && stepped('likes')
        && stepped('saves')
        && stepped('views')
        && stepped('shares')
        && stepped('likesCount');
    }

    match /users/{uid} {
      allow read: if true;
      allow create: if isOwner(uid)
        && request.resource.data.role in ['artist', 'enthusiast']
        && request.resource.data.suspended != true
        && request.resource.data.disabled != true
        && request.resource.data.pendingDelete != true
        && noPrivateProfileFields();
      allow update: if isAdmin()
        || (isOwner(uid) && userProtectedUntouched() && artistStatusAllowed() && privateProfileUnchangedOrRemoved())
        || (signedIn() && changedOnly(['likesCount', 'followersCount', 'viewedCount', 'sharedCount'])
            && stepped('likesCount') && stepped('followersCount') && stepped('viewedCount') && stepped('sharedCount'));
      allow delete: if isAdmin();

      match /private/{docId} {
        allow read: if isAdmin() || isOwner(uid);
        allow create, update: if isAdmin() || isOwner(uid);
        allow delete: if isAdmin() || isOwner(uid);
      }
    }

    match /listings/{id} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.artistId == request.auth.uid;
      allow update: if isAdmin()
        || (signedIn() && resource.data.artistId == request.auth.uid)
        || (signedIn() && engagementStep());
      allow delete: if isAdmin() || (signedIn() && resource.data.artistId == request.auth.uid);
    }

    match /listings/{id}/ratings/{ratingId} {
      allow read: if true;
      allow create, update: if signedIn() && ratingId == request.auth.uid;
      allow delete: if signedIn() && ratingId == request.auth.uid;
    }

    match /portfolios/{id} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.artistId == request.auth.uid;
      allow update: if isAdmin()
        || (signedIn() && resource.data.artistId == request.auth.uid)
        || (signedIn() && engagementStep());
      allow delete: if isAdmin() || (signedIn() && resource.data.artistId == request.auth.uid);
    }

    match /events/{id} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.artistId == request.auth.uid;
      allow update, delete: if isAdmin() || (signedIn() && resource.data.artistId == request.auth.uid);
    }

    match /comments/{id} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
    }

    match /reports/{id} {
      allow read: if isAdmin();
      allow create: if signedIn()
        && request.resource.data.reportedBy == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /verificationRequests/{uid} {
      allow read: if isAdmin() || isOwner(uid);
      allow create, update: if isOwner(uid) && request.resource.data.status == 'pending'
        || isAdmin();
      allow delete: if isAdmin();
    }

    match /notifications/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if isAdmin()
        || (signedIn() && request.resource.data.fromUserId == request.auth.uid)
        || (signedIn() && request.resource.data.userId == request.auth.uid);
      allow update: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid && changedOnly(['read']));
      allow delete: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
    }

    match /chats/{chatId} {
      allow read, update: if signedIn() && request.auth.uid in resource.data.participants;
      allow create: if signedIn() && request.auth.uid in request.resource.data.participants;
      allow delete: if isAdmin() || (signedIn() && request.auth.uid in resource.data.participants);

      match /messages/{messageId} {
        allow read: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow create: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
          && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if false;
      }
    }

    match /groupChats/{chatId} {
      allow read: if signedIn();
      allow create, update: if signedIn();
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if signedIn();
        allow create: if signedIn() && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if false;
      }
    }

    match /following/{id} {
      allow read: if true;
      allow create: if signedIn() && (
        request.resource.data.userId == request.auth.uid
        || request.resource.data.followerId == request.auth.uid
      );
      allow delete: if signedIn() && (
        resource.data.userId == request.auth.uid
        || resource.data.followerId == request.auth.uid
      );
      allow update: if false;
    }

    match /likes/{id} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
      allow update: if false;
    }

    match /saves/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
      allow update: if false;
    }

    match /saved/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
      allow update: if false;
    }

    match /views/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    match /shares/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    match /orders/{id} {
      allow read: if signedIn() && (resource.data.buyerId == request.auth.uid || resource.data.artistId == request.auth.uid || isAdmin());
      allow create: if signedIn() && request.resource.data.buyerId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /user_likes/{id} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
      allow update: if false;
    }

    match /user_saves/{id} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
      allow update: if false;
    }

    match /user_shares/{id} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    match /view_history/{id} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    match /saleRecords/{id} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.artistId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /analytics/{artistId}/weeklySales/{weekId} {
      allow read, write: if isAdmin() || isOwner(artistId);
    }

    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
